# ====================================================================
# Hydra Engine - Git Ignore Configuration
# ====================================================================

# Build Output & Tool Binaries
bin/
bin-int/
**/bin/
**/bin-int/

# Premake Automation Downloads
vendor/premake/bin/premake5
vendor/premake/bin/premake5.exe
vendor/premake/bin/*.zip
vendor/premake/bin/*.tar.gz
vendor/premake/bin/LICENSE.txt

# Python Cache
**/__pycache__/

# IDEs and Workspace Configurations
.vs/
.vscode/
*.userf
*.suo
.VSCodeCounter/

# Visual Studio Build Files
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Linux/macOS Build Artifacts
Makefile
*.make
*.workspace
*.solution
*.o
*.a
*.so
*.d
*.dylib

# Engine/Editor Cache & Dynamic Logs
Hydra/vendor/VulkanSDK/
HydraEditor/assets/cache/
*.log

# Profiling Logs
HydraProfile-*.json
*Profile-*.json



# C# build intermediates (the built .dll files themselves stay tracked so
# the editor can load scripts without a Mono compiler installed)
**/Intermediates/

# Stale ImGui layout generated when an app is launched from the repo root
/imgui.ini
